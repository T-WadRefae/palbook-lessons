const dlgBox=document.getElementById('dialogue');
DLG.forEach(sec=>{
  const wrap=document.createElement('div');wrap.className='dlg-sec';
  const plain=sec.lines.map(l=>l.who+': '+l.t.replace(/\[[gp]\|([^|]+)\|[^\]]+\]/g,'$1')).join('. ');
  let html=`<div class="sec-head"><span class="sec-chip">${sec.chip}</span>
    <button class="btn btn-listen" onclick="speak(this.dataset.txt,'en',this)" data-txt="${plain.replace(/"/g,'&quot;')}">🔊 Listen to this part</button></div><div class="chat">`;
  sec.lines.forEach(l=>{
    html+=`<div class="bubble-row ${l.side}"><div class="avatar ${l.av}">${l.who[0]}</div>
      <div class="bubble"><span class="name-tag">${l.who}</span>${render(l.t)}</div></div>`;
  });
  html+=`</div><div class="sec-q"><div class="qt">🧠 Comprehension <span class="ar">(اضغط السؤال لرؤية الإجابة)</span></div>`;
  sec.q.forEach(qq=>html+=`<details class="qa"><summary>${qq.q}</summary><div class="ans">${qq.a}</div></details>`);
  html+=`</div>`;wrap.innerHTML=html;dlgBox.appendChild(wrap);
});

/* ===== QUIZ ===== */
const QZ_VOCAB=[
  {q:'What does "landline" mean?',opts:['الهاتف المحمول','الهاتف الأرضي','الإنترنت','التلفاز'],a:1},
  {q:'"go online" means…',opts:['يُغلق الهاتف','يشاهد التلفاز','يتصل بالإنترنت','يكتب رسالة'],a:2},
  {q:'Which title is used for a married woman?',opts:['Mr','Miss','Mrs','Sir'],a:2},
  {q:'"at the moment" is closest to…',opts:['yesterday','right now','last week','tomorrow'],a:1},
  {q:'The opposite of "go online" is…',opts:['go offline','log in','connect','chat'],a:0}
];
const QZ_DLG=[
  {q:'Why is Tina calling Nadia\'s mobile a problem?',opts:['It is broken.','It is expensive.','It is busy.','It is off.'],a:1},
  {q:'Who is using the family landline?',opts:['Sami','Tina','Nadia\'s mum','Dad'],a:2},
  {q:'What is Sami doing on the computer?',opts:['Writing a project','Chatting online','Watching sport','Reading email'],a:1},
  {q:'Where does Grandma live?',opts:['London','Jenin','Gaza','Tina\'s house'],a:1},
  {q:'At the end, what can the girls change to?',opts:['the computer','the mobile','the landline','email'],a:2}
];
function buildQuiz(list,box,prefix){
  list.forEach((m,i)=>{
    const d=document.createElement('div');d.className='qz';
    d.innerHTML=`<div class="q"><span class="n">${prefix}${i+1}.</span> ${m.q}</div>`;
    m.opts.forEach((o,oi)=>{
      const b=document.createElement('button');b.className='opt';b.innerHTML=o+'<span class="mark"></span>';
      b.dataset.correct=(oi===m.a)?'1':'0';
      b.onclick=()=>{const p=b.parentElement;[...p.querySelectorAll('.opt')].forEach(x=>{x.classList.remove('correct','wrong','sel');x.querySelector('.mark').textContent='';});
        b.classList.add('sel');b.dataset.sel='1';p.dataset.answered='1';updateProgress();};
      d.appendChild(b);});
    box.appendChild(d);
  });
}
buildQuiz(QZ_VOCAB,document.getElementById('quizVocab'),'V');
buildQuiz(QZ_DLG,document.getElementById('quizDlg'),'D');
function updateProgress(){
  const total=10;
  const answered=[...document.querySelectorAll('#quiz .qz')].filter(q=>q.dataset.answered==='1').length;
  document.getElementById('qzFill').style.width=(answered/total*100)+'%';
}
function gradeBlock(box){
  let score=0;
  [...box.querySelectorAll('.qz')].forEach(q=>{
    const opts=[...q.querySelectorAll('.opt')];opts.forEach(o=>o.classList.add('locked'));
    const sel=opts.find(o=>o.dataset.sel==='1');
    const cor=opts.find(o=>o.dataset.correct==='1');
    cor.classList.add('correct');cor.querySelector('.mark').textContent='✓';
    if(sel){if(sel.dataset.correct==='1'){score++;}else{sel.classList.add('wrong');sel.querySelector('.mark').textContent='✗';}}
  });
  return score;
}
function showScore(){
  const v=gradeBlock(document.getElementById('quizVocab'));
  const d=gradeBlock(document.getElementById('quizDlg'));
  const total=v+d;
  document.getElementById('bdVocab').textContent=v;
  document.getElementById('bdDlg').textContent=d;
  document.getElementById('scoreNum').textContent=total;
  const pct=total/10*360;
  document.getElementById('scoreRing').style.background=`conic-gradient(var(--violet) ${pct}deg, var(--lilac-d) ${pct}deg)`;
  const msg=document.getElementById('resultMsg'),sub=document.getElementById('resultSub');
  if(total===10){msg.textContent='🏆 Perfect!';sub.textContent='ممتاز جداً! إتقان كامل، أحسنت.';}
  else if(total>=8){msg.textContent='🌟 Excellent!';sub.textContent='أداء رائع — أنت قريب جداً من الإتقان الكامل.';}
  else if(total>=6){msg.textContent='👍 Good job!';sub.textContent='جيد! راجع الأخطاء وحاول مرة أخرى لرفع نتيجتك.';}
  else if(total>=4){msg.textContent='💪 Keep going!';sub.textContent='لا بأس — أعِد قراءة المفردات والمحادثة ثم جرّب ثانية.';}
  else{msg.textContent='📚 Let\'s review!';sub.textContent='لنراجع الدرس معاً ثم نُعيد الاختبار، ستتحسّن بإذن الله.';}
  document.getElementById('resultCard').classList.add('show');
  document.getElementById('resultCard').scrollIntoView({behavior:'smooth',block:'center'});
  if(total>=8){confetti();}
}
function resetQuiz(){
  document.querySelectorAll('#quiz .opt').forEach(o=>{o.classList.remove('correct','wrong','sel','locked');o.querySelector('.mark').textContent='';delete o.dataset.sel;});
  document.querySelectorAll('#quiz .qz').forEach(q=>delete q.dataset.answered);
  document.getElementById('qzFill').style.width='0%';
  document.getElementById('resultCard').classList.remove('show');
  window.scrollTo({top:document.getElementById('quiz').offsetTop-20,behavior:'smooth'});
}
/* tiny confetti */
function confetti(){
  const cols=['#7c5cf0','#ffc83d','#26d0bd','#ff79b0','#5fb3ff'];
  for(let i=0;i<60;i++){
    const p=document.createElement('div');
    p.style.cssText=`position:fixed;width:10px;height:14px;border-radius:3px;z-index:999;top:-20px;left:${Math.random()*100}vw;background:${cols[i%cols.length]};opacity:.95;pointer-events:none;transform:rotate(${Math.random()*360}deg)`;
    document.body.appendChild(p);
    const dur=2200+Math.random()*1500;
    p.animate([{transform:`translateY(0) rotate(0)`},{transform:`translateY(105vh) rotate(${720+Math.random()*360}deg)`}],{duration:dur,easing:'cubic-bezier(.4,.1,.5,1)'});
    setTimeout(()=>p.remove(),dur);
  }
}
