<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Unit 1 — Hello World! | Interactive Lesson</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Fredoka:wght@400;500;600;700&family=Nunito:wght@500;600;700;800;900&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet" />
<style>
  :root{
    --bg:#f3efff;
    --bg2:#ece4ff;
    --card:#ffffff;
    --ink:#33285f;
    --ink-soft:#7468a3;
    --violet:#7c5cf0;
    --violet-d:#6442d8;
    --violet-l:#b9a6ff;
    --lilac:#f1ebff;
    --lilac-d:#e1d6ff;
    --amber:#ffc83d;
    --amber-d:#ffae00;
    --teal:#26d0bd;
    --teal-d:#11a896;
    --pink:#ff79b0;
    --pink-d:#ff4f97;
    --green:#3ccf78;
    --green-d:#22a85e;
    --red:#ff6b7a;
    --sky:#5fb3ff;
    --shadow:0 22px 45px -18px rgba(92,60,200,.45);
    --shadow-sm:0 10px 24px -12px rgba(92,60,200,.4);
    --shadow-card:0 14px 30px -16px rgba(92,60,200,.32);
    --r:26px;
  }
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Nunito','Tajawal',sans-serif;color:var(--ink);line-height:1.55;overflow-x:hidden;
    background:
      radial-gradient(900px 500px at 8% -6%, #e3d4ff 0%, transparent 55%),
      radial-gradient(800px 520px at 108% 4%, #ffe1f1 0%, transparent 52%),
      radial-gradient(700px 600px at 50% 120%, #d9f6f1 0%, transparent 55%),
      linear-gradient(165deg,var(--bg),var(--bg2));
    min-height:100vh;
  }
  /* floating decorative blobs */
  .blob{position:fixed;border-radius:46% 54% 60% 40%/50% 46% 54% 50%;z-index:0;pointer-events:none;opacity:.5;filter:blur(.5px);animation:drift 16s ease-in-out infinite;}
  .bl1{width:180px;height:180px;background:linear-gradient(135deg,#c9b3ff,#a98bff);top:12%;left:-4%;}
  .bl2{width:140px;height:140px;background:linear-gradient(135deg,#ffc1dd,#ff9ec4);top:68%;left:90%;animation-delay:-5s;}
  .bl3{width:110px;height:110px;background:linear-gradient(135deg,#9ff0e4,#5fe0cf);top:84%;left:4%;animation-delay:-9s;}
  @keyframes drift{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-30px) rotate(8deg)}}

  .wrap{position:relative;z-index:1;max-width:1080px;margin:0 auto;padding:16px 14px 90px;}

  /* ---------- HERO (clean compact) ---------- */
  header.hero{
    position:relative;border-radius:26px;padding:0;overflow:hidden;color:#fff;
    box-shadow:0 20px 44px -20px rgba(92,60,200,.5);
    background:
      radial-gradient(380px 180px at 92% 6%, rgba(255,255,255,.28), transparent 62%),
      radial-gradient(300px 200px at 2% 104%, rgba(255,182,232,.32), transparent 60%),
      linear-gradient(120deg,#7a59f2 0%,#9576ff 46%,#bb98ff 80%,#dcc2ff 100%);
    animation:heroIn .7s cubic-bezier(.2,.9,.3,1) both;
  }
  header.hero::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.12),transparent 30%);pointer-events:none;z-index:2;}
  @keyframes heroIn{from{opacity:0;transform:translateY(14px) scale(.99)}to{opacity:1;transform:none}}
  .hero-inner{position:relative;z-index:3;display:flex;align-items:center;gap:14px;padding:18px 22px;min-height:96px;}

  /* abstract geometric shapes */
  .shape{position:absolute;z-index:1;pointer-events:none;}
  .ring{border-radius:50%;border:2px solid rgba(255,255,255,.3);background:transparent;}
  .r1{width:120px;height:120px;top:-46px;right:14%;animation:hfloat 12s ease-in-out infinite;}
  .r2{width:54px;height:54px;bottom:-22px;right:30%;border-color:rgba(255,255,255,.22);animation:hfloat 9s ease-in-out infinite -3s;}
  .soft-blob{border-radius:46% 54% 60% 40%/52% 44% 56% 48%;filter:blur(3px);}
  .bl-a{width:130px;height:130px;background:radial-gradient(circle at 34% 30%,rgba(255,255,255,.34),rgba(255,255,255,.04));top:-44px;right:4%;animation:hfloat 11s ease-in-out infinite -1s;}
  .bl-b{width:96px;height:96px;background:radial-gradient(circle at 34% 30%,rgba(255,168,220,.5),rgba(255,168,220,.04));bottom:-40px;left:-22px;animation:hfloat 13s ease-in-out infinite -5s;}
  .dot{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.55);}
  .d1{top:24px;right:46%;animation:twinkle 3.4s ease-in-out infinite;}
  .d2{bottom:20px;right:8%;width:6px;height:6px;animation:twinkle 2.6s ease-in-out infinite -1s;}
  .d3{top:50%;left:40%;width:5px;height:5px;animation:twinkle 3s ease-in-out infinite -.6s;}
  @keyframes hfloat{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-14px) rotate(8deg)}}
  @keyframes twinkle{0%,100%{opacity:.25;transform:scale(.8)}50%{opacity:.9;transform:scale(1.15)}}

  /* badge */
  .unit-badge{
    flex:none;display:inline-flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;
    width:58px;height:58px;background:rgba(255,255,255,.18);backdrop-filter:blur(12px);
    border:1.5px solid rgba(255,255,255,.45);color:#fff;font-family:'Baloo 2',cursive;font-weight:800;
    border-radius:18px;box-shadow:inset 0 1px 0 rgba(255,255,255,.4),0 8px 18px -8px rgba(40,10,90,.5);
    animation:fadeUp .6s .1s both;
  }
  .unit-badge .em{font-size:1.25rem;line-height:1;}
  .unit-badge small{font-size:.6rem;letter-spacing:.6px;font-weight:700;opacity:.95;}

  .hero-text{position:relative;z-index:3;flex:1 1 auto;min-width:0;animation:fadeUp .6s .2s both;}
  .hero h1{font-family:'Baloo 2',cursive;font-weight:800;font-size:clamp(1.5rem,5.4vw,2.1rem);line-height:1;text-shadow:0 3px 0 rgba(70,30,150,.2),0 8px 20px rgba(40,10,90,.28);}
  .hero h1 .accent{background:linear-gradient(180deg,#fff3c4,#ffd25a);-webkit-background-clip:text;background-clip:text;color:transparent;}
  .hero .subtitle{font-weight:700;opacity:.9;font-size:.8rem;margin-top:4px;display:flex;align-items:center;gap:6px;}
  @keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

  /* floating emoji cluster (right) — glass tiles */
  .emoji-cluster{flex:none;position:relative;width:150px;height:78px;z-index:3;animation:fadeUp .6s .3s both;}
  .e-tile{
    position:absolute;width:38px;height:38px;display:grid;place-items:center;font-size:1.15rem;border-radius:13px;
    background:rgba(255,255,255,.2);backdrop-filter:blur(8px);border:1.5px solid rgba(255,255,255,.42);
    box-shadow:0 8px 16px -8px rgba(40,10,90,.5);animation:tileFloat 6s ease-in-out infinite;transition:.2s;
  }
  .e-tile:hover{transform:translateY(-4px) scale(1.08) rotate(-3deg);background:rgba(255,255,255,.34);}
  .et1{top:2px;left:6px;animation-delay:0s;}
  .et2{top:0;left:56px;animation-delay:-1.4s;}
  .et3{top:8px;left:106px;animation-delay:-2.6s;}
  .et4{top:42px;left:30px;animation-delay:-1.9s;}
  .et5{top:40px;left:82px;animation-delay:-3.3s;}
  .e-spark{position:absolute;font-size:.85rem;z-index:4;animation:twinkle 2.8s ease-in-out infinite;}
  .es1{top:-4px;left:44px;animation-delay:-.4s;}
  .es2{bottom:-2px;left:0;animation-delay:-1.6s;}
  @keyframes tileFloat{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-8px) rotate(3deg)}}

  @media(max-width:600px){
    .hero-inner{padding:14px 16px;gap:11px;min-height:84px;}
    .emoji-cluster{width:96px;height:72px;}
    .et3,.et5{display:none;}
    .hero .subtitle{font-size:.74rem;}
  }

  /* ---------- TABS ---------- */
  nav.tabs{display:flex;gap:9px;margin:18px 0;overflow-x:auto;padding:4px;scrollbar-width:none;}
  nav.tabs::-webkit-scrollbar{display:none;}
  .tab-btn{
    flex:1 0 auto;border:none;cursor:pointer;font-family:'Fredoka',sans-serif;font-weight:600;
    background:#fff;color:var(--ink-soft);border:2px solid transparent;border-radius:18px;padding:11px 16px;font-size:.92rem;
    display:flex;align-items:center;gap:8px;white-space:nowrap;transition:.25s cubic-bezier(.34,1.4,.5,1);box-shadow:var(--shadow-card);
  }
  .tab-btn .ico{font-size:1.15rem;}
  .tab-btn:hover{transform:translateY(-3px);color:var(--violet-d);}
  .tab-btn.active{background:linear-gradient(135deg,var(--violet),var(--violet-d));color:#fff;transform:translateY(-3px);box-shadow:0 14px 26px -10px rgba(124,92,240,.7);}

  /* ---------- PANELS ---------- */
  .panel{display:none;}
  .panel.show{display:block;animation:pop .45s cubic-bezier(.34,1.3,.5,1) both;}
  @keyframes pop{from{opacity:0;transform:translateY(18px) scale(.98)}to{opacity:1;transform:none}}

  .card{background:var(--card);border-radius:var(--r);padding:22px 20px;box-shadow:var(--shadow-card);position:relative;overflow:hidden;}
  .card-h{display:flex;align-items:center;gap:13px;margin-bottom:18px;}
  .qnum{flex:none;width:46px;height:46px;border-radius:15px;display:grid;place-items:center;font-family:'Baloo 2',cursive;font-weight:800;font-size:1.3rem;color:#fff;background:linear-gradient(135deg,var(--violet),var(--pink));box-shadow:0 10px 18px -8px rgba(124,92,240,.65);}
  .card-h h2{font-family:'Baloo 2',cursive;font-weight:700;font-size:1.2rem;}
  .card-h .en{font-size:.78rem;color:var(--ink-soft);font-weight:700;}

  /* ===== BENTO GRID (objectives) ===== */
  .bento{display:grid;grid-template-columns:repeat(6,1fr);gap:14px;}
  .bento .cell{border-radius:22px;padding:18px;position:relative;overflow:hidden;color:#fff;box-shadow:var(--shadow-card);transition:.25s;display:flex;flex-direction:column;gap:6px;min-height:120px;}
  .bento .cell:hover{transform:translateY(-4px) scale(1.01);}
  .bento .cell .big{font-size:2rem;line-height:1;}
  .bento .cell b{font-family:'Baloo 2',cursive;font-size:1.05rem;font-weight:700;}
  .bento .cell span{font-size:.84rem;font-weight:700;opacity:.95;}
  .bento .cell .ar{direction:rtl;font-family:'Tajawal';font-size:.82rem;opacity:.92;}
  .bento .cell::after{content:"";position:absolute;width:90px;height:90px;border-radius:50%;background:rgba(255,255,255,.16);right:-30px;bottom:-30px;}
  .c-span6{grid-column:span 6;} .c-span4{grid-column:span 4;} .c-span3{grid-column:span 3;} .c-span2{grid-column:span 2;}
  .g-violet{background:linear-gradient(135deg,#8a6bff,#6442d8);}
  .g-teal{background:linear-gradient(135deg,#2fd6c4,#11a896);}
  .g-pink{background:linear-gradient(135deg,#ff8cc0,#ff4f97);}
  .g-amber{background:linear-gradient(135deg,#ffce5c,#ffae00);color:#6b4800;}
  .g-sky{background:linear-gradient(135deg,#74bdff,#3f93f5);}
  .can-do{margin-top:14px;background:linear-gradient(135deg,#fff8e3,#fff0c6);border:1.5px dashed var(--amber-d);border-radius:22px;padding:18px;}
  .can-do h3{font-family:'Baloo 2',cursive;color:#9a6b00;font-size:1.08rem;margin-bottom:10px;display:flex;gap:8px;align-items:center;}
  .can-do ul{list-style:none;display:grid;gap:7px;}
  .can-do li{font-weight:700;color:#7a5500;font-size:.92rem;display:flex;gap:9px;align-items:center;direction:rtl;font-family:'Tajawal';}
  .can-do li::before{content:"✓";color:var(--green-d);font-weight:900;background:#fff;border-radius:50%;width:20px;height:20px;display:grid;place-items:center;font-size:.7rem;flex:none;}

  /* ===== VOCAB CARDS ===== */
  .legend{display:flex;gap:14px;flex-wrap:wrap;font-size:.78rem;color:var(--ink-soft);font-weight:700;margin-bottom:14px;direction:rtl;font-family:'Tajawal';}
  .legend span{display:inline-flex;align-items:center;gap:5px;}
  .swatch{width:16px;height:12px;border-radius:3px;display:inline-block;}
  .grid-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:15px;}
  .flip{perspective:1200px;height:180px;cursor:pointer;}
  .flip-inner{position:relative;width:100%;height:100%;transition:transform .65s cubic-bezier(.4,.2,.2,1);transform-style:preserve-3d;}
  .flip.flipped .flip-inner{transform:rotateY(180deg);}
  .flip-face{position:absolute;inset:0;border-radius:22px;backface-visibility:hidden;-webkit-backface-visibility:hidden;display:flex;flex-direction:column;padding:16px;}
  .flip-front{background:linear-gradient(155deg,#fff,#f3edff);border:2px solid var(--lilac-d);align-items:center;justify-content:center;text-align:center;box-shadow:var(--shadow-card);}
  .flip-front .emoji{font-size:2rem;margin-bottom:8px;}
  .flip-front .word{font-family:'Baloo 2',cursive;font-weight:800;font-size:1.15rem;color:var(--violet-d);line-height:1.1;}
  .flip-front .hint{font-size:.7rem;color:var(--ink-soft);font-weight:700;margin-top:10px;opacity:.8;direction:rtl;font-family:'Tajawal';}
  .flip-back{background:linear-gradient(155deg,var(--violet),#9b7bff);color:#fff;transform:rotateY(180deg);justify-content:center;gap:8px;}
  .flip-back .ar{font-family:'Tajawal';font-weight:800;font-size:1.3rem;text-align:center;direction:rtl;}
  .flip-back .row{font-size:.78rem;display:flex;gap:6px;align-items:baseline;direction:rtl;justify-content:center;flex-wrap:wrap;}
  .flip-back .row .lbl{background:rgba(255,255,255,.24);border-radius:7px;padding:1px 8px;font-weight:800;font-size:.66rem;}
  .flip-back .row .val{font-family:'Tajawal';font-weight:700;}
  .spk{position:absolute;top:9px;inset-inline-end:9px;width:32px;height:32px;border-radius:50%;border:none;cursor:pointer;background:var(--amber);color:#6b4800;display:grid;place-items:center;font-size:.95rem;z-index:3;box-shadow:0 5px 0 var(--amber-d);transition:.12s;}
  .spk:active{transform:translateY(3px);box-shadow:0 2px 0 var(--amber-d);}
  .flip-back .spk{background:#fff;color:var(--violet-d);box-shadow:0 5px 0 var(--lilac-d);}

  /* ===== ACTIVITIES ===== */
  .embed-img{width:100%;border-radius:20px;border:3px solid #fff;box-shadow:var(--shadow);display:block;}
  .img-cap{font-size:.82rem;color:var(--ink-soft);font-weight:700;text-align:center;margin-top:10px;direction:rtl;font-family:'Tajawal';}
  .order-q{background:linear-gradient(135deg,#f6f1ff,#efe7ff);border-radius:20px;padding:16px;margin-top:14px;border:1.5px solid var(--lilac-d);}
  .order-q .label{font-weight:800;color:var(--violet-d);margin-bottom:4px;display:flex;gap:8px;align-items:center;font-size:.95rem;}
  .order-q .ar-instr{direction:rtl;font-family:'Tajawal';color:var(--ink-soft);font-size:.85rem;margin-bottom:12px;font-weight:600;}
  .pool,.answer-line{display:flex;flex-wrap:wrap;gap:8px;min-height:50px;padding:11px;border-radius:14px;}
  .answer-line{background:#fff;border:2px dashed var(--violet-l);margin-bottom:8px;align-items:center;}
  .answer-line:empty::before{content:"اضغط الكلمات بالترتيب الصحيح…";color:#b6acd8;font-family:'Tajawal';direction:rtl;width:100%;text-align:center;font-weight:600;font-size:.85rem;}
  .pool{background:rgba(124,92,240,.07);}
  .chip-word{background:#fff;border:2px solid var(--lilac-d);border-radius:13px;padding:9px 14px;font-weight:800;cursor:pointer;font-size:.95rem;color:var(--ink);transition:.15s;box-shadow:0 4px 0 var(--lilac-d);user-select:none;}
  .chip-word:hover{transform:translateY(-2px);border-color:var(--violet);}
  .chip-word:active{transform:translateY(2px);box-shadow:0 1px 0 var(--lilac-d);}
  .answer-line .chip-word{background:var(--violet);color:#fff;border-color:var(--violet-d);box-shadow:0 4px 0 var(--violet-d);}
  .order-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px;}
  .feedback{margin-top:11px;border-radius:14px;padding:11px 15px;font-weight:800;display:none;font-size:.92rem;direction:rtl;font-family:'Tajawal';}
  .feedback.ok{display:block;background:#e3faec;color:var(--green-d);border:1.5px solid #9fe8bf;}
  .feedback.no{display:block;background:#ffe9ec;color:#d23b4a;border:1.5px solid #ffc2c9;}

  .btn{border:none;cursor:pointer;font-family:'Fredoka',sans-serif;font-weight:600;border-radius:14px;padding:10px 18px;font-size:.9rem;display:inline-flex;align-items:center;gap:7px;transition:.14s;}
  .btn-primary{background:linear-gradient(135deg,var(--violet),var(--violet-d));color:#fff;box-shadow:0 6px 0 #4f33b8;}
  .btn-primary:active{transform:translateY(4px);box-shadow:0 2px 0 #4f33b8;}
  .btn-ghost{background:#fff;color:var(--violet-d);border:2px solid var(--lilac-d);}
  .btn-listen{background:linear-gradient(135deg,var(--teal),var(--teal-d));color:#fff;box-shadow:0 6px 0 #088576;}
  .btn-listen:active{transform:translateY(4px);box-shadow:0 2px 0 #088576;}
  .btn-listen.playing{background:linear-gradient(135deg,var(--amber),var(--amber-d));color:#6b4800;box-shadow:0 6px 0 var(--amber-d);}

  .listen-box{background:linear-gradient(135deg,#e7fffb,#d2fff5);border:1.5px solid #9fe8de;border-radius:20px;padding:18px;margin-top:6px;}
  .listen-box .top{display:flex;align-items:center;gap:12px;flex-wrap:wrap;}
  .listen-box .top .t{font-weight:800;color:var(--teal-d);}
  .passage-text{margin-top:13px;background:#fff;border-radius:14px;padding:15px;font-weight:600;line-height:1.75;font-size:.96rem;display:none;}
  .passage-text.reveal{display:block;}
  .src-note{font-size:.74rem;color:var(--ink-soft);margin-top:9px;direction:rtl;font-family:'Tajawal';}
  .src-note a{color:var(--teal-d);font-weight:800;}

  .mcq .q{font-weight:800;margin:16px 0 8px;font-size:.98rem;}
  .mcq .q .n{color:var(--violet-d);}
  .opt{display:block;width:100%;text-align:start;background:#fff;border:2px solid var(--lilac-d);border-radius:14px;padding:12px 15px;margin-bottom:8px;font-weight:700;font-size:.93rem;cursor:pointer;transition:.15s;color:var(--ink);}
  .opt:hover{border-color:var(--violet);transform:translateX(3px);}
  .opt.correct{background:#e3faec;border-color:var(--green);color:var(--green-d);}
  .opt.wrong{background:#ffe9ec;border-color:var(--red);color:#d23b4a;}
  .opt .mark{float:right;font-weight:900;}

  /* ===== DIALOGUE — chat bubbles ===== */
  .dlg-intro{background:linear-gradient(135deg,#fff5e6,#ffe9c6);border:1.5px dashed var(--amber-d);border-radius:20px;padding:15px 17px;font-weight:700;color:#7a5500;margin-bottom:18px;font-size:.95rem;}
  .dlg-sec{background:linear-gradient(160deg,#faf7ff,#f3eeff);border:1.5px solid var(--lilac-d);border-radius:24px;padding:18px;margin-bottom:18px;box-shadow:var(--shadow-card);}
  .sec-head{display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap;}
  .sec-chip{background:linear-gradient(135deg,var(--violet),var(--violet-d));color:#fff;font-weight:800;border-radius:13px;padding:6px 14px;font-size:.84rem;box-shadow:var(--shadow-sm);}
  /* chat bubble layout */
  .chat{display:flex;flex-direction:column;gap:12px;}
  .bubble-row{display:flex;gap:10px;align-items:flex-end;max-width:88%;}
  .bubble-row.left{align-self:flex-start;}
  .bubble-row.right{align-self:flex-end;flex-direction:row-reverse;}
  .avatar{flex:none;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;font-family:'Baloo 2',cursive;font-weight:800;color:#fff;font-size:1.1rem;box-shadow:var(--shadow-sm);}
  .av-nadia{background:linear-gradient(135deg,#ff8cc0,#ff4f97);}
  .av-tina{background:linear-gradient(135deg,#74bdff,#3f93f5);}
  .bubble{position:relative;padding:11px 15px;border-radius:20px;font-weight:600;font-size:.96rem;line-height:1.6;box-shadow:var(--shadow-sm);}
  .left .bubble{background:#fff;border-bottom-left-radius:6px;}
  .right .bubble{background:linear-gradient(135deg,#ece4ff,#e0d4ff);border-bottom-right-radius:6px;}
  .name-tag{font-size:.68rem;font-weight:800;color:var(--ink-soft);margin-bottom:3px;display:block;}
  .gw{border-bottom:2px dotted var(--violet);cursor:help;position:relative;font-weight:800;color:var(--violet-d);}
  .gw:hover{background:var(--lilac);border-radius:4px;}
  .pron{background:var(--amber);color:#6b4800;border-radius:6px;padding:0 5px;font-weight:800;cursor:help;position:relative;border-bottom:2px solid var(--amber-d);}
  .tip{position:absolute;bottom:140%;left:50%;transform:translateX(-50%) translateY(6px);background:var(--ink);color:#fff;border-radius:12px;padding:9px 13px;font-size:.82rem;font-weight:700;min-width:140px;max-width:230px;text-align:center;opacity:0;pointer-events:none;transition:.2s;z-index:40;box-shadow:0 12px 26px -8px rgba(0,0,0,.5);direction:rtl;font-family:'Tajawal';}
