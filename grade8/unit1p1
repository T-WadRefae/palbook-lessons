<script>
/* ===== TTS (safe) ===== */
let voices=[];
let TTS_OK=false;
try{ TTS_OK = (typeof window!=='undefined') && ('speechSynthesis' in window) && !!window.speechSynthesis; }catch(e){ TTS_OK=false; }
function loadVoices(){ try{ voices = TTS_OK ? window.speechSynthesis.getVoices() : []; }catch(e){ voices=[]; } }
if(TTS_OK){ try{ loadVoices(); window.speechSynthesis.onvoiceschanged=loadVoices; }catch(e){} }
function ttsCancel(){ try{ if(TTS_OK) window.speechSynthesis.cancel(); }catch(e){} }
function pickVoice(l){ if(!voices.length) loadVoices(); return voices.find(v=>v.lang&&v.lang.toLowerCase().startsWith(l))||null; }
function speak(t,lang='en',btn=null){
  if(!TTS_OK){
    if(btn){ btn.classList.add('playing'); setTimeout(()=>btn.classList.remove('playing'),700); }
    return; // gracefully do nothing if speech is unavailable (e.g. preview sandbox)
  }
  try{
    ttsCancel();
    const u=new SpeechSynthesisUtterance(t);
    u.lang=lang==='ar'?'ar-SA':'en-GB';
    const v=pickVoice(lang==='ar'?'ar':'en'); if(v)u.voice=v;
    u.rate=lang==='ar'?.9:.82; u.pitch=1;
    if(btn){ btn.classList.add('playing'); u.onend=()=>btn.classList.remove('playing'); u.onerror=()=>btn.classList.remove('playing'); }
    window.speechSynthesis.speak(u);
  }catch(e){ if(btn) btn.classList.remove('playing'); }
}

/* ===== TABS ===== */
document.querySelectorAll('.tab-btn').forEach(b=>{
  b.onclick=()=>{
    document.querySelectorAll('.tab-btn').forEach(x=>x.classList.remove('active'));
    document.querySelectorAll('.panel').forEach(x=>x.classList.remove('show'));
    b.classList.add('active');document.getElementById(b.dataset.tab).classList.add('show');
    ttsCancel();window.scrollTo({top:0,behavior:'smooth'});
  };
});

/* ===== VOCAB ===== */
const VOCAB=[
  {w:'at the moment',e:'⏳',ar:'في الوقت الحاضر',syn:'right now / currently',ant:'in the past'},
  {w:'family',e:'👨‍👩‍👧‍👦',ar:'عائلة / أُسرة',syn:'household / relatives',ant:'stranger'},
  {w:'go online',e:'🌐',ar:'يتصل بالإنترنت',syn:'connect to the internet',ant:'go offline'},
  {w:'Grandma',e:'👵',ar:'الجدّة',syn:'grandmother',ant:'Grandpa'},
  {w:'landline (phone)',e:'☎️',ar:'الهاتف الأرضي',syn:'home / fixed line',ant:'mobile phone'},
  {w:'Mrs',e:'👩',ar:'السيّدة (متزوّجة)',syn:'married-woman title',ant:'Miss'},
  {w:'on the phone',e:'📱',ar:'يتكلّم هاتفياً',syn:'making a call',ant:'off the phone'},
  {w:'project',e:'📌',ar:'مشروع',syn:'task / assignment',ant:'—'},
  {w:'so',e:'➡️',ar:'لذلك / إذن',syn:'therefore',ant:'—'},
  {w:'Mr',e:'👨',ar:'السيّد',syn:'title for a man',ant:'Mrs / Ms'}
];
const grid=document.getElementById('vocabGrid');
VOCAB.forEach(v=>{
  const c=document.createElement('div');c.className='flip';
  c.innerHTML=`<div class="flip-inner">
    <div class="flip-face flip-front">
      <button class="spk" onclick="event.stopPropagation();speak('${v.w.replace(/'/g,"\\'")}','en',this)">🔊</button>
      <div class="emoji">${v.e}</div><div class="word">${v.w}</div><div class="hint">👆 اضغط للقلب</div>
    </div>
    <div class="flip-face flip-back">
      <button class="spk" onclick="event.stopPropagation();speak('${v.ar.replace(/'/g,"\\'")}','ar',this)">🔊</button>
      <div class="ar">${v.ar}</div>
      <div class="row"><span class="lbl">مرادف</span><span class="val">${v.syn}</span></div>
      <div class="row"><span class="lbl">ضد</span><span class="val">${v.ant}</span></div>
    </div></div>`;
  c.onclick=()=>c.classList.toggle('flipped');grid.appendChild(c);
});

/* ===== ORDERING ===== */
const ORDER=[
  {id:'o1',correct:['The','girl','is','watching','TV.'],ar:'البنت تشاهد التلفاز.'},
  {id:'o2',correct:['The','boy','is','using','a','computer.'],ar:'الولد يستخدم الحاسوب.'},
  {id:'o3',correct:['Their','father','is','speaking','on','a','mobile','phone.'],ar:'والدهم يتحدّث على الهاتف المحمول.'},
  {id:'o4',correct:['Their','mother','is','chatting','on','a','landline','phone.'],ar:'والدتهم تتحدّث على الهاتف الأرضي.'}
];
function shuffle(a){a=[...a];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
const ow=document.getElementById('orderWrap');window.ORDERMAP={};
ORDER.forEach((q,qi)=>{
  window.ORDERMAP[q.id]=q.correct;
  const box=document.createElement('div');box.className='order-q';
  box.innerHTML=`<div class="label">🔤 Sentence ${qi+1}</div><div class="ar-instr">${q.ar}</div>
    <div class="answer-line" id="ans-${q.id}"></div><div class="pool" id="pool-${q.id}"></div>
    <div class="order-actions">
      <button class="btn btn-primary" onclick="checkOrder('${q.id}')">✅ Check</button>
      <button class="btn btn-ghost" onclick="resetOrder('${q.id}')">↺ Reset</button>
      <button class="btn btn-listen" onclick="speak(window.ORDERMAP['${q.id}'].join(' '),'en',this)">🔊 Correct</button>
    </div><div class="feedback" id="fb-${q.id}"></div>`;
  ow.appendChild(box);
  const pool=box.querySelector('#pool-'+q.id);
  shuffle(q.correct).forEach(w=>{const ch=document.createElement('button');ch.className='chip-word';ch.textContent=w;ch.onclick=()=>moveChip(ch,q.id);pool.appendChild(ch);});
});
function moveChip(ch,id){const ans=document.getElementById('ans-'+id);ch.parentElement.classList.contains('pool')?ans.appendChild(ch):document.getElementById('pool-'+id).appendChild(ch);}
function checkOrder(id){
  const got=[...document.getElementById('ans-'+id).children].map(c=>c.textContent);
  const fb=document.getElementById('fb-'+id),cor=window.ORDERMAP[id];
  if(got.length===cor.length&&got.every((w,i)=>w===cor[i])){fb.className='feedback ok';fb.textContent='🎉 أحسنت! ترتيب صحيح تماماً.';speak(cor.join(' '),'en');}
  else if(!got.length){fb.className='feedback no';fb.textContent='ابدأ بالضغط على الكلمات لترتيبها 🙂';}
  else{fb.className='feedback no';fb.textContent='✋ ليس بعد — راجع الترتيب وحاول مرة أخرى.';}
}
function resetOrder(id){const pool=document.getElementById('pool-'+id);[...document.getElementById('ans-'+id).children].forEach(c=>pool.appendChild(c));document.getElementById('fb-'+id).className='feedback';}

/* ===== LISTENING + MCQ ===== */
function readPassage(b){speak(document.getElementById('passageText').textContent.trim(),'en',b);}
function togglePassage(){document.getElementById('passageText').classList.toggle('reveal');}
const MCQ=[
  {q:'What do you know about Nadia and her family?',opts:["They are from London and visiting Jenin.","They are from Palestine but living in London now.","They live in Jenin with Grandma.","They are Tina's neighbours in Palestine."],a:1},
  {q:"Who is Tina?",opts:["Nadia's sister.","Nadia's grandmother.","Nadia's friend.","Nadia's teacher."],a:2},
  {q:"Is Nadia using her mobile or the family landline?",opts:["The family landline.","Her mobile phone.","Her brother's computer.","The school phone."],a:1},
  {q:"What is Nadia's mother doing in the kitchen?",opts:["Watching TV.","Chatting online.","Speaking on the phone to Grandma.","Making a project."],a:2}
];
const mcqBox=document.getElementById('mcq');
MCQ.forEach((m,i)=>{
  const d=document.createElement('div');d.innerHTML=`<div class="q"><span class="n">Q${i+1}.</span> ${m.q}</div>`;
  m.opts.forEach((o,oi)=>{
    const b=document.createElement('button');b.className='opt';b.innerHTML=o+'<span class="mark"></span>';
    b.onclick=()=>{const p=b.parentElement;[...p.querySelectorAll('.opt')].forEach(x=>{x.classList.remove('correct','wrong');x.querySelector('.mark').textContent='';});
      if(oi===m.a){b.classList.add('correct');b.querySelector('.mark').textContent='✓';}
      else{b.classList.add('wrong');b.querySelector('.mark').textContent='✗';const c=p.querySelectorAll('.opt')[m.a];c.classList.add('correct');c.querySelector('.mark').textContent='✓';}};
    d.appendChild(b);});
  mcqBox.appendChild(d);
});

/* ===== DIALOGUE (chat bubbles) ===== */
function render(t){return t
  .replace(/\[g\|([^|]+)\|([^\]]+)\]/g,(m,w,ar)=>`<span class="gw" tabindex="0">${w}<span class="tip"><span class="lt">${w}</span>${ar}</span></span>`)
  .replace(/\[p\|([^|]+)\|([^\]]+)\]/g,(m,w,r)=>`<span class="pron" tabindex="0">${w}<span class="tip"><span class="lt">pronoun</span>${r}</span></span>`);}
const DLG=[
  {chip:'Part 1 · Greeting',lines:[
    {who:'Nadia',side:'left',av:'av-nadia',t:'Hello. Nadia speaking.'},
    {who:'Tina',side:'right',av:'av-tina',t:"Hi, Nadia. [p|It's|It = هذه المكالمة] Tina. How are [p|you|you = ناديا]?"},
    {who:'Nadia',side:'left',av:'av-nadia',t:'Fine, thanks. And you?'},
    {who:'Tina',side:'right',av:'av-tina',t:"[p|I'm|I = تينا] fine, too. Listen, [p|we|we = ناديا وتينا] need to [g|plan|نُخطّط] [p|our|our = الخاص بنا] school [g|project|مشروع]."}
  ],q:[{q:'Who calls who?',a:'Tina calls Nadia.'},{q:'What do they need to plan?',a:'Their school project.'}]},

  {chip:'Part 2 · The call & the landline',lines:[
    {who:'Nadia',side:'left',av:'av-nadia',t:"Right. But why are you calling [p|my|my = الخاص بناديا] mobile? [p|That's|That = الاتصال بالموبايل] [g|expensive|مُكلِف / غالٍ]."},
    {who:'Tina',side:'right',av:'av-tina',t:"[p|I|I = تينا] tried [p|your|your = الخاص بناديا] [g|landline|الهاتف الأرضي], but [p|it|it = الهاتف الأرضي] was [g|busy|مشغول]."},
    {who:'Nadia',side:'left',av:'av-nadia',t:"Ah, yes. [p|Mum's|Mum = والدة ناديا] using the phone in the kitchen to call [p|her|her = والدة ناديا] mother. [g|Grandma|الجدّة] lives in Jenin, and [p|they|they = الأم والجدّة] talk on the phone every week."}
  ],q:[{q:'Why is calling the mobile a problem?',a:'Because it is expensive.'},{q:'Why was the landline busy?',a:"Nadia's mum was using it to call Grandma in Jenin."}]},

  {chip:'Part 3 · Computer & internet',lines:[
    {who:'Tina',side:'right',av:'av-tina',t:"Well, let's [g|email|نُراسل بالبريد الإلكتروني] each other."},
    {who:'Nadia',side:'left',av:'av-nadia',t:"Sorry, but [p|we|we = ناديا وتينا] can't [g|at the moment|في الوقت الحاضر]. [p|My|My = الخاص بناديا] brother Sami is using the computer. [p|He's|He = سامي] [g|chatting|يُدردش] to [p|his|his = الخاص بسامي] friends [g|online|عبر الإنترنت]."},
    {who:'Tina',side:'right',av:'av-tina',t:'Oh, no!'},
    {who:'Nadia',side:'left',av:'av-nadia',t:'Sami always [g|goes online|يتّصل بالإنترنت] in the evening.'},
    {who:'Tina',side:'right',av:'av-tina',t:"So let's [g|carry on|نُكمِل / نَستمِر] with [p|your|your = الخاص بناديا] mobile."}
  ],q:[{q:'Why can they not email?',a:'Sami is using the computer to chat online.'},{q:'When does Sami go online?',a:'In the evening.'}]},

  {chip:'Part 4 · Change to the landline',lines:[
    {who:'Nadia',side:'left',av:'av-nadia',t:"Yes, but not here. [p|Dad's|Dad = والد ناديا] watching the [g|sport|الرياضة] on TV."},
    {who:'Tina',side:'right',av:'av-tina',t:'Ah, so are you [g|moving|تنتقلين] to the next room?'},
    {who:'Nadia',side:'left',av:'av-nadia',t:"Yes … But [g|guess what!|خمّني ماذا!] [p|Mum's|Mum = والدة ناديا] [g|finishing|تُنهي مكالمتها]."},
    {who:'Tina',side:'right',av:'av-tina',t:"So [p|we|we = ناديا وتينا] can [g|change to|نُحوِّل إلى] the landline. Great!"}
  ],q:[{q:'Why can Nadia not stay in that room?',a:'Her dad is watching sport on TV.'},{q:'What good news does Nadia share?',a:'Her mum is finishing, so they can change to the landline.'}]}
