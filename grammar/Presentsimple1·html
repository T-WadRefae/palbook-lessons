/* ---------- Exercise 3: Match game ---------- */
var matchPairs = [
  {id:"w", en:"It is windy 🪁", act:"We fly kites", actAr:"نطيّر الطائرات الورقية"},
  {id:"h", en:"It is hot ☀️", act:"We go to the beach", actAr:"نذهب إلى الشاطئ"},
  {id:"r", en:"It is rainy 🌧️", act:"They look at flowers", actAr:"ينظرون إلى الأزهار"}
];
(function buildMatch(){
  var L = document.getElementById("matchL");
  var R = document.getElementById("matchR");
  if(!L||!R) return;
  // weather (right column, fixed order)
  matchPairs.forEach(function(p){
    var d = document.createElement("div");
    d.className = "m-item"; d.dataset.id = p.id; d.dataset.side = "L";
    d.innerHTML = '<span class="en">'+p.en+'</span>';
    L.appendChild(d);
  });
  // activities shuffled
  var acts = matchPairs.slice().sort(function(){return Math.random()-.5;});
  acts.forEach(function(p){
    var d = document.createElement("div");
    d.className = "m-item"; d.dataset.id = p.id; d.dataset.side = "R";
    d.innerHTML = '<span class="en">'+p.act+'</span><br><small>'+p.actAr+'</small>';
    R.appendChild(d);
  });
  var pickedL = null, pickedR = null, done = 0;
  var msg = document.getElementById("matchMsg");
  function tryMatch(){
    if(pickedL && pickedR){
      if(pickedL.dataset.id === pickedR.dataset.id){
        pickedL.classList.add("done"); pickedR.classList.add("done");
        pickedL.classList.remove("picked"); pickedR.classList.remove("picked");
        speak(matchPairs.filter(function(x){return x.id===pickedL.dataset.id;})[0].act);
        done++;
        if(done===matchPairs.length){ msg.textContent = "🎉 رائع! وصلت كل الأزواج بشكل صحيح!"; }
      }else{
        var a=pickedL,b=pickedR;
        a.style.borderColor="#e63946"; b.style.borderColor="#e63946";
        msg.textContent = "❌ حاول مرة أخرى.";
        setTimeout(function(){
          a.style.borderColor=""; b.style.borderColor="";
          a.classList.remove("picked"); b.classList.remove("picked");
          msg.textContent="";
        },650);
      }
      pickedL=null; pickedR=null;
    }
  }
  document.querySelectorAll("#matchL .m-item, #matchR .m-item").forEach(function(it){
    it.addEventListener("click", function(){
      if(it.classList.contains("done")) return;
      if(it.dataset.side==="L"){
        if(pickedL) pickedL.classList.remove("picked");
        pickedL = it; it.classList.add("picked");
      }else{
        if(pickedR) pickedR.classList.remove("picked");
        pickedR = it; it.classList.add("picked");
      }
      tryMatch();
    });
  });
})();

