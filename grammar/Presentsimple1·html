<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>مذكرات المستكشف اليومية — Present Simple</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&family=Patrick+Hand&family=Gochi+Hand&display=swap" rel="stylesheet">
<style>
:root{
  --cream:#faf6e9;
  --cream2:#f3edd8;
  --line:#cfe0f2;
  --margin:#e76f6f;
  --kraft:#c8985f;
  --kraft2:#b9854c;
  --ink:#2c2b3a;
  --blue:#2d6cdf;
  --red:#e63946;
  --green:#3fa34d;
  --green2:#51cf66;
  --sun:#ffd43b;
  --tape-y:#ffe066;
  --tape-b:#83c5ec;
  --tape-p:#ffb3c7;
  --note-y:#fff3a8;
  --note-g:#bfe3a6;
  --note-o:#ffcf6b;
  --shadow:0 8px 22px rgba(60,45,20,.18);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{
  font-family:'Cairo',sans-serif;
  color:var(--ink);
  background:
    radial-gradient(circle at 12% 8%, rgba(255,255,255,.5), transparent 30%),
    var(--cream);
  background-color:var(--cream);
  line-height:1.6;
  min-height:100%;
  padding:14px;
}
.en{font-family:'Patrick Hand','Cairo',sans-serif;direction:ltr;unicode-bidi:isolate;letter-spacing:.3px}
.marker{font-family:'Gochi Hand','Patrick Hand',cursive;direction:ltr;unicode-bidi:isolate}
.wrap{max-width:1000px;margin:0 auto}

/* ===== HEADER ===== */
header{
  position:relative;
  background:var(--cream2);
  background-image:repeating-linear-gradient(transparent,transparent 27px,#dfe9f5 27px,#dfe9f5 28px);
  border:1px solid #e6dcc0;
  border-radius:16px;
  box-shadow:var(--shadow);
  padding:18px 22px 20px;
  text-align:center;
  overflow:hidden;
}
header::before{content:"";position:absolute;top:0;bottom:0;right:46px;width:2px;background:rgba(231,111,111,.5)}
.tape{position:absolute;width:84px;height:26px;opacity:.85;border-radius:2px;
  background:repeating-linear-gradient(45deg,rgba(255,255,255,.35) 0 6px,transparent 6px 12px)}
.tape.t1{top:-8px;right:60px;transform:rotate(-7deg);background-color:var(--tape-y)}
.tape.t2{top:-8px;left:70px;transform:rotate(8deg);background-color:var(--tape-b)}
.tape.t3{bottom:-8px;left:120px;transform:rotate(-5deg);background-color:var(--tape-p)}
h1{font-size:clamp(1.5rem,5vw,2.4rem);font-weight:900;color:var(--ink);line-height:1.25}
h1 .hl{color:var(--blue)}
.subtitle{font-size:clamp(.85rem,2.8vw,1.05rem);color:#6b6657;font-weight:600;margin-top:4px}
.diary-en{font-family:'Gochi Hand',cursive;direction:ltr;font-size:clamp(1rem,3.4vw,1.35rem);color:var(--blue);margin-top:6px}
.teacher{
  display:inline-block;margin-top:10px;padding:5px 16px;border-radius:30px;
  background:var(--note-y);color:#7a5b00;font-weight:700;font-size:.85rem;
  transform:rotate(-1.5deg);box-shadow:0 3px 8px rgba(0,0,0,.12)
}
.deco{position:absolute;font-size:1.6rem;opacity:.9}
.deco.sun{top:14px;right:18px;animation:spin 22s linear infinite}
.deco.kite{bottom:12px;left:18px;animation:floaty 5s ease-in-out infinite}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes floaty{0%,100%{transform:translateY(0) rotate(-6deg)}50%{transform:translateY(-7px) rotate(4deg)}}

/* ===== TABS ===== */
nav{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:18px 0}
.tab-btn{
  font-family:'Cairo',sans-serif;font-weight:700;font-size:.9rem;cursor:pointer;
  border:none;padding:9px 14px;border-radius:12px;color:#5a533f;
  background:var(--cream2);border:1.5px solid #e2d7ba;
  box-shadow:0 3px 0 #d8cba6;transition:transform .12s,background .2s;
  display:flex;align-items:center;gap:6px
}
.tab-btn .en{font-size:.92em}
.tab-btn:hover{transform:translateY(-2px)}
.tab-btn.active{background:var(--blue);color:#fff;border-color:var(--blue);box-shadow:0 3px 0 #1d4ea3}
.tab-btn .ico{font-size:1.05rem}

/* ===== PANELS ===== */
.panel{display:none;animation:fade .4s ease}
.panel.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

.card{
  position:relative;background:var(--cream2);
  border:1px solid #e6dcc0;border-radius:16px;box-shadow:var(--shadow);
  padding:22px 20px;margin-bottom:18px
}
.card.paper{background-color:#fdfbf2;background-image:repeating-linear-gradient(transparent,transparent 29px,#dbe7f6 29px,#dbe7f6 30px)}
.sec-title{font-size:clamp(1.15rem,4vw,1.6rem);font-weight:900;margin-bottom:6px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.sec-title .en{color:#7a7464;font-size:.78em}
.lead{color:#6b6657;font-weight:600;margin-bottom:16px}

/* sticky note */
.note{
  position:relative;background:var(--note-y);border-radius:6px;padding:14px 16px;
  box-shadow:0 6px 14px rgba(0,0,0,.14);font-weight:700;color:#6a5400;
  transform:rotate(-1.4deg);line-height:1.55
}
.note.g{background:var(--note-g);color:#2f5320}
.note.o{background:var(--note-o);color:#7a4d00}
.note::after{content:"";position:absolute;top:-9px;right:50%;transform:translateX(50%);width:60px;height:18px;background:rgba(255,255,255,.45);border-radius:2px}

/* objectives list */
.aims{display:grid;gap:12px}
.aim{display:flex;gap:12px;align-items:flex-start;background:#fff;border:1.5px dashed #d9cba2;border-radius:12px;padding:12px 14px}
.aim .b{flex:none;width:34px;height:34px;border-radius:9px;display:grid;place-items:center;font-size:1.2rem;background:var(--tape-b)}
.aim:nth-child(2n) .b{background:var(--tape-y)}
.aim:nth-child(3n) .b{background:var(--tape-p)}
.aim p{font-weight:600}

/* time loop */
.loop-wrap{text-align:center}
.loop{font-size:clamp(2.4rem,11vw,4.6rem);font-weight:900;color:var(--blue);letter-spacing:.1em;margin:6px 0}
.loop .past{color:var(--red)}.loop .pres{color:var(--green)}.loop .fut{color:var(--blue)}
.loop-line{display:flex;justify-content:center;gap:18px;flex-wrap:wrap;font-weight:800;margin-bottom:8px}
.loop-line span{padding:4px 12px;border-radius:20px}
.loop-line .p1{background:#ffd6d6;color:#b02a2a}
.loop-line .p2{background:#d6f5dc;color:#2f7a3c}
.loop-line .p3{background:#d6e6ff;color:#1d4ea3}
.use-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}
.use{background:#fff;border-radius:12px;padding:14px;border:1.5px solid #ecdfbf;text-align:center}
.use .ic{font-size:2rem}
.use h4{margin:6px 0 2px}
.example-line{margin-top:16px;text-align:center;font-size:clamp(1.1rem,4.4vw,1.6rem);color:var(--blue);font-weight:700}

/* polaroid */
.pola-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:16px}
.pola{background:#fff;padding:10px 10px 12px;border-radius:6px;box-shadow:var(--shadow);text-align:center;transform:rotate(var(--r,-2deg));transition:transform .2s;cursor:pointer}
.pola:hover{transform:rotate(0) translateY(-3px)}
.pola .pic{height:96px;border-radius:4px;display:grid;place-items:center;font-size:3rem;background:linear-gradient(135deg,#dff0ff,#cfe7d8)}
.pola .pin{position:absolute}
.pola .cap-en{font-family:'Patrick Hand',cursive;direction:ltr;font-size:1.05rem;margin-top:8px;font-weight:400}
.pola .cap-ar{font-size:.82rem;color:#6b6657;font-weight:700}
.spk{margin-top:6px;border:none;background:var(--tape-b);width:34px;height:34px;border-radius:50%;cursor:pointer;font-size:1rem;box-shadow:0 2px 5px rgba(0,0,0,.15)}
.spk:active{transform:scale(.9)}

/* magic S balance */
.balance{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:14px 0}
.scale-side{background:#fff;border-radius:14px;padding:16px;text-align:center;border:2px solid #ecdfbf}
.scale-side.heavy{border-color:var(--sun);box-shadow:0 0 0 3px #fff3c4}
.scale-side h4{font-size:1.5rem;margin-bottom:8px}
.balloons{font-size:1.6rem}
.pron-chip{display:inline-block;background:var(--blue);color:#fff;padding:3px 12px;border-radius:20px;margin:3px;font-weight:700}
.pron-chip.s{background:#444}
.verb-box{font-family:'Patrick Hand',cursive;direction:ltr;font-size:1.2rem;background:#fff7d6;border-radius:8px;padding:8px;margin-top:10px;font-weight:400}
.verb-box .es{color:var(--red);font-weight:bold}

/* wheel of year */
.wheel{display:grid;grid-template-columns:1fr 1fr;gap:0;max-width:420px;margin:6px auto 0;border-radius:50%;overflow:hidden;border:10px solid var(--kraft);box-shadow:var(--shadow);aspect-ratio:1/1}
.season{cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:14px;transition:filter .2s,transform .2s;text-align:center}
.season:hover{filter:brightness(1.06)}
.season.sel{box-shadow:inset 0 0 0 4px #fff}
.season.winter{background:#cfe9f7}
.season.spring{background:#d6efce}
.season.summer{background:#ffe9a8}
.season.autumn{background:#e8d3a8}
.season .nm{font-weight:900;font-size:1rem}
.season .nm .en{font-size:.85em;color:#555}
.season .mon{font-family:'Patrick Hand',cursive;direction:ltr;font-size:.82rem;margin-top:4px}
.wheel-info{text-align:center;margin-top:14px;min-height:30px;font-weight:700;color:var(--blue)}

/* weather cards */
.weather-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:14px}
.wcard{background:linear-gradient(160deg,#fff,#f3eeda);border:3px solid #cdbf99;border-radius:16px;padding:14px;text-align:center;box-shadow:var(--shadow)}
.wcard .we{font-size:2.6rem}
.wcard .en{display:block;font-size:1.3rem;font-weight:700;margin-top:4px}
.wcard .ar{font-size:.9rem;color:#6b6657;font-weight:700}

/* pattern box */
.pattern{background:#fffbe0;border:3px solid var(--sun);border-radius:14px;padding:16px;text-align:center;margin-top:16px}
.pattern .frm{font-family:'Patrick Hand',cursive;direction:ltr;font-size:clamp(1.1rem,4.5vw,1.5rem);font-weight:400}
.pattern .ex{font-family:'Patrick Hand',cursive;direction:ltr;color:var(--red);margin-top:6px;font-size:1.05rem}

/* matrix table */
.matrix{width:100%;border-collapse:separate;border-spacing:8px}
.matrix th{background:#cfcad9;border-radius:8px;padding:10px;font-size:.9rem}
.matrix th .en{font-size:.8em;color:#555}
.matrix td{background:#fff;border-radius:8px;padding:10px;text-align:center;font-weight:600}
.matrix tr:nth-child(2) td{background:#fff8d8}
.matrix tr:nth-child(3) td{background:#ffe0ec}
.matrix tr:nth-child(4) td{background:#dff0ff}
.matrix .en{direction:ltr;display:inline-block}
.matrix .es{color:var(--red);font-weight:900}

/* exercises */
.ex-block{margin-bottom:22px}
.ex-head{font-weight:900;font-size:1.05rem;margin-bottom:4px;display:flex;align-items:center;gap:8px}
.ex-head .num{background:var(--blue);color:#fff;width:28px;height:28px;border-radius:50%;display:grid;place-items:center;font-size:.9rem;flex:none}
.ex-hint{color:#6b6657;font-weight:600;font-size:.88rem;margin-bottom:12px}
.q-item{background:#fff;border:1.5px solid #ecdfbf;border-radius:12px;padding:14px;margin-bottom:12px}
.q-text{font-family:'Patrick Hand',cursive;direction:ltr;font-size:1.15rem;margin-bottom:10px;font-weight:400}
.q-text .blank{display:inline-block;min-width:70px;border-bottom:3px dotted var(--blue);text-align:center}
.opts{display:flex;flex-wrap:wrap;gap:8px}
.opt{font-family:'Patrick Hand',cursive;direction:ltr;font-size:1.05rem;cursor:pointer;border:2px solid #d9cba2;background:#fbf7ea;border-radius:10px;padding:8px 16px;font-weight:400;transition:.15s}
.opt:hover{background:#fff}
.opt.correct{background:#d6f5dc;border-color:var(--green);color:#2f7a3c}
.opt.wrong{background:#ffd9d9;border-color:var(--red);color:#b02a2a}
.opt.disabled{pointer-events:none;opacity:.85}
.fb{margin-top:8px;font-weight:700;font-size:.9rem;display:none}
.fb.show{display:block;animation:fade .3s}
.fb.ok{color:var(--green)}
.fb.no{color:var(--red)}

/* match game */
.match{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.match-col{display:flex;flex-direction:column;gap:10px}
.match-col .lbl{font-weight:900;text-align:center;color:#6b6657}
.m-item{cursor:pointer;background:#fff;border:2px solid #d9cba2;border-radius:12px;padding:12px;font-weight:600;text-align:center;transition:.15s}
.m-item .en{font-family:'Patrick Hand',cursive;font-size:1.05rem;font-weight:400}
.m-item:hover{background:#fbf7ea}
.m-item.picked{border-color:var(--blue);box-shadow:0 0 0 3px #cfe0f7}
.m-item.done{background:#d6f5dc;border-color:var(--green);color:#2f7a3c;pointer-events:none}
.match-msg{text-align:center;font-weight:800;margin-top:14px;color:var(--green);min-height:24px}

.btn{font-family:'Cairo',sans-serif;font-weight:700;cursor:pointer;border:none;border-radius:12px;padding:11px 22px;font-size:1rem;background:var(--blue);color:#fff;box-shadow:0 4px 0 #1d4ea3;transition:transform .12s}
.btn:hover{transform:translateY(-2px)}
.btn:active{transform:translateY(1px);box-shadow:0 2px 0 #1d4ea3}
.btn.alt{background:var(--green);box-shadow:0 4px 0 #2c7a39}
.btn.ghost{background:#fff;color:var(--blue);border:2px solid var(--blue);box-shadow:0 4px 0 #cfe0f7}
.center{text-align:center}

/* quiz */
.quiz-progress{text-align:center;font-weight:800;color:#6b6657;margin-bottom:6px}
.bar{height:10px;background:#e6dcc0;border-radius:20px;overflow:hidden;margin-bottom:16px}
.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--green),var(--blue));width:0;transition:width .4s;border-radius:20px}
.quiz-q{font-size:1.15rem;font-weight:800;margin-bottom:4px}
.quiz-q .en{display:block;font-size:1.25rem;color:var(--blue);margin-top:4px;font-weight:400}
.quiz-opts{display:grid;gap:10px;margin-top:14px}
.quiz-opt{cursor:pointer;background:#fff;border:2px solid #d9cba2;border-radius:12px;padding:13px 16px;font-weight:600;text-align:right;transition:.15s;display:flex;align-items:center;gap:10px}
.quiz-opt .en{font-family:'Patrick Hand',cursive;font-weight:400;font-size:1.1rem}
.quiz-opt:hover{background:#fbf7ea}
.quiz-opt.correct{background:#d6f5dc;border-color:var(--green)}
.quiz-opt.wrong{background:#ffd9d9;border-color:var(--red)}
.quiz-opt.disabled{pointer-events:none}
.quiz-fb{margin-top:14px;padding:12px 14px;border-radius:12px;font-weight:700;display:none}
.quiz-fb.show{display:block;animation:fade .3s}
.quiz-fb.ok{background:#d6f5dc;color:#2f7a3c}
.quiz-fb.no{background:#ffe0e0;color:#b02a2a}

/* results */
.result{text-align:center;display:none}
.result.show{display:block;animation:fade .5s}
.result .star{font-size:4rem;animation:pop .6s ease}
@keyframes pop{0%{transform:scale(0)}70%{transform:scale(1.25)}100%{transform:scale(1)}}
.result .score{font-size:2.4rem;font-weight:900;color:var(--blue)}
.result .tier{font-size:1.3rem;font-weight:900;margin:6px 0}
.result .msg{font-weight:700;color:#6b6657;margin-bottom:16px}

/* confetti */
.confetti{position:fixed;top:-12px;width:10px;height:14px;z-index:999;pointer-events:none;border-radius:2px}

footer{text-align:center;color:#9a907a;font-size:.8rem;padding:14px 0 4px;font-weight:600}

@media(max-width:560px){
  .use-grid{grid-template-columns:1fr}
  .balance{grid-template-columns:1fr}
  .match{grid-template-columns:1fr 1fr;gap:10px}
  .matrix th,.matrix td{padding:7px;font-size:.78rem}
  .tab-btn{font-size:.8rem;padding:8px 10px}
}
</style>
</head>
<body>
<div class="wrap">

  <!-- HEADER -->
  <header>
    <span class="tape t1"></span><span class="tape t2"></span><span class="tape t3"></span>
    <span class="deco sun">🌞</span><span class="deco kite">🪁</span>
    <h1>مذكرات المستكشف اليومية<br><span class="hl">سر «المضارع البسيط»</span></h1>
    <div class="subtitle">كيف نتحدّث عن يومنا، فصولنا، وعالمنا!</div>
    <div class="diary-en">The Everyday Explorer's Diary · Present Simple</div>
    <div class="teacher">✏️ إعداد المعلّمة T. Wad Refae</div>
  </header>

  <!-- TABS -->
  <nav id="tabs">
    <button class="tab-btn active" data-tab="aims"><span class="ico">🎯</span><span class="en">Objectives</span></button>
    <button class="tab-btn" data-tab="rule"><span class="ico">♾️</span><span class="en">The Rule</span></button>
    <button class="tab-btn" data-tab="habits"><span class="ico">🪥</span><span class="en">Habits & Magic S</span></button>
    <button class="tab-btn" data-tab="weather"><span class="ico">🌦️</span><span class="en">Seasons & Weather</span></button>
    <button class="tab-btn" data-tab="practice"><span class="ico">✍️</span><span class="en">Practice</span></button>
    <button class="tab-btn" data-tab="quiz"><span class="ico">🏆</span><span class="en">Quiz</span></button>
  </nav>

  <!-- ================= OBJECTIVES ================= -->
  <section class="panel active" id="aims">
    <div class="card paper">
      <div class="sec-title">🎯 أهداف الرحلة <span class="en">Our Goals</span></div>
      <p class="lead">في نهاية هذه المذكّرة سيكون المستكشف الصغير قادراً على:</p>
      <div class="aims">
        <div class="aim"><div class="b">⏰</div><p>معرفة متى نستخدم المضارع البسيط: <b>العادات اليومية</b> و<b>الحقائق الدائمة</b>.</p></div>
        <div class="aim"><div class="b">🎈</div><p>استخدام الضمائر المريحة <span class="en">(I, You, We, They)</span> مع الفعل الأساسي بدون إضافات.</p></div>
        <div class="aim"><div class="b">✨</div><p>إتقان «الحرف السحري <span class="en">S/ES</span>» مع <span class="en">He / She / It</span>.</p></div>
        <div class="aim"><div class="b">🗓️</div><p>التحدّث عن <b>الفصول والشهور</b> وحالة <b>الطقس</b>.</p></div>
        <div class="aim"><div class="b">🫒</div><p>وصف عاداتنا اليومية في <b>فلسطين</b> بجمل صحيحة وواثقة.</p></div>
      </div>
      <div class="note" style="margin-top:18px">📌 نصيحة المستكشف: اقرأ الجمل بصوتٍ عالٍ، واضغط على زر 🔊 لتسمع النطق الصحيح!</div>
    </div>
  </section>

  <!-- ================= THE RULE ================= -->
  <section class="panel" id="rule">
    <div class="card paper loop-wrap">
      <div class="sec-title" style="justify-content:center">♾️ حلقة الزمن التي لا تتوقف <span class="en">The Time Loop</span></div>
      <div class="loop-line">
        <span class="p1">الماضي · Past</span>
        <span class="p2">الحاضر · Present</span>
        <span class="p3">المستقبل · Future</span>
      </div>
      <div class="loop">∞</div>
      <div class="example-line en">I play every day.  ·  The sun is hot.</div>
      <div class="use-grid">
        <div class="use"><div class="ic">🪥</div><h4>العادات اليومية</h4><div class="en">Everyday habits</div></div>
        <div class="use"><div class="ic">☀️</div><h4>الحقائق الدائمة</h4><div class="en">Permanent facts</div></div>
      </div>
      <div class="note" style="margin-top:18px;display:inline-block">نستخدم المضارع البسيط <span class="en">(Present Simple)</span> للحديث عن أشياء تتكرّر دائماً.</div>
    </div>
  </section>

  <!-- ================= HABITS + MAGIC S ================= -->
  <section class="panel" id="habits">
    <!-- daily habits -->
    <div class="card">
      <div class="sec-title">🪥 عاداتي اليومية <span class="en">My Daily Habits</span></div>
      <p class="lead">اضغط على البطاقة لتقرأها، وعلى 🔊 لتسمعها.</p>
      <div class="pola-grid">
        <div class="pola" style="--r:-3deg">
          <div class="pic">🧼</div>
