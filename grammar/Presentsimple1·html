<script>
"use strict";

/* ---------- TTS (safe) ---------- */
var TTS_OK = (typeof window !== "undefined") && ("speechSynthesis" in window);
function speak(text){
  if(!TTS_OK) return;
  try{
    window.speechSynthesis.cancel();
    var u = new SpeechSynthesisUtterance(text);
    u.lang = "en-US"; u.rate = .9; u.pitch = 1;
    window.speechSynthesis.speak(u);
  }catch(e){/* graceful fallback */}
}
document.addEventListener("click", function(e){
  var b = e.target.closest(".spk");
  if(b){ speak(b.getAttribute("data-say")); }
});

/* ---------- Tabs ---------- */
var tabs = document.querySelectorAll(".tab-btn");
var panels = document.querySelectorAll(".panel");
tabs.forEach(function(t){
  t.addEventListener("click", function(){
    tabs.forEach(function(x){x.classList.remove("active");});
    panels.forEach(function(p){p.classList.remove("active");});
    t.classList.add("active");
    var el = document.getElementById(t.getAttribute("data-tab"));
    if(el) el.classList.add("active");
    window.scrollTo({top:0,behavior:"smooth"});
  });
});

/* ---------- Wheel of year ---------- */
var wheel = document.getElementById("wheel");
var wheelInfo = document.getElementById("wheelInfo");
if(wheel){
  wheel.querySelectorAll(".season").forEach(function(s){
    s.addEventListener("click", function(){
      wheel.querySelectorAll(".season").forEach(function(x){x.classList.remove("sel");});
      s.classList.add("sel");
      wheelInfo.textContent = s.getAttribute("data-info");
    });
  });
}

/* ---------- Helper: build MC exercise ---------- */
function buildMC(containerId, items){
  var box = document.getElementById(containerId);
  if(!box) return;
  items.forEach(function(it){
    var wrap = document.createElement("div");
    wrap.className = "q-item";
    var qt = document.createElement("div");
    qt.className = "q-text";
    qt.innerHTML = it.text;
    var opts = document.createElement("div");
    opts.className = "opts";
    var fb = document.createElement("div");
    fb.className = "fb";
    it.options.forEach(function(opt){
      var b = document.createElement("button");
      b.className = "opt"; b.textContent = opt;
      b.addEventListener("click", function(){
        opts.querySelectorAll(".opt").forEach(function(o){o.classList.add("disabled");});
        if(opt === it.answer){
          b.classList.add("correct");
          fb.className = "fb ok show"; fb.textContent = "✅ أحسنت! إجابة صحيحة.";
        }else{
          b.classList.add("wrong");
          opts.querySelectorAll(".opt").forEach(function(o){ if(o.textContent===it.answer) o.classList.add("correct"); });
          fb.className = "fb no show"; fb.textContent = "❌ الإجابة الصحيحة: " + it.answer + " — " + (it.why||"");
        }
        speak(it.answer);
      });
      opts.appendChild(b);
    });
    wrap.appendChild(qt); wrap.appendChild(opts); wrap.appendChild(fb);
    box.appendChild(wrap);
  });
}

