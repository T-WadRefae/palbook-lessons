var qi = 0, score = 0, answered = false;
var qProg = document.getElementById("qProg");
var qBar  = document.getElementById("qBar");
var qText = document.getElementById("qText");
var qOpts = document.getElementById("qOpts");
var qFb   = document.getElementById("qFb");
var qNext = document.getElementById("qNext");
var quizBody = document.getElementById("quizBody");
var qResult = document.getElementById("qResult");

function renderQ(){
  answered = false;
  var item = QUIZ[qi];
  qProg.textContent = "سؤال " + (qi+1) + " من " + QUIZ.length;
  qBar.style.width = ((qi)/QUIZ.length*100) + "%";
  qText.innerHTML = item.q + '<span class="en">'+item.en+'</span>';
  qOpts.innerHTML = "";
  qFb.className = "quiz-fb"; qFb.textContent = "";
  qNext.style.display = "none";
  // shuffle options but track correct text
  var correctText = item.options[item.a];
  var shuffled = item.options.map(function(o,idx){return {o:o,c:idx===item.a};}).sort(function(){return Math.random()-.5;});
  shuffled.forEach(function(s){
    var b = document.createElement("div");
    b.className = "quiz-opt";
    b.innerHTML = '<span>'+s.o+'</span>';
    b.addEventListener("click", function(){
      if(answered) return;
      answered = true;
      qOpts.querySelectorAll(".quiz-opt").forEach(function(o){o.classList.add("disabled");});
      if(s.c){
        b.classList.add("correct"); score++;
        qFb.className = "quiz-fb ok show"; qFb.textContent = "✅ ممتاز! " + item.why;
      }else{
        b.classList.add("wrong");
        qOpts.querySelectorAll(".quiz-opt").forEach(function(o){
          if(o.textContent.trim()===correctText) o.classList.add("correct");
        });
        qFb.className = "quiz-fb no show"; qFb.textContent = "❌ الصحيح: " + correctText + " — " + item.why;
      }
      qNext.style.display = "inline-block";
      qNext.textContent = (qi===QUIZ.length-1) ? "🎯 شاهد النتيجة" : "التالي ➟";
    });
    qOpts.appendChild(b);
  });
}

qNext.addEventListener("click", function(){
  if(qi < QUIZ.length-1){ qi++; renderQ(); }
  else{ showResult(); }
});

function showResult(){
  quizBody.style.display = "none";
  qResult.classList.add("show");
  document.getElementById("rScore").textContent = score + " / " + QUIZ.length;
  var pct = score / QUIZ.length;
  var tier = document.getElementById("rTier");
  var msg = document.getElementById("rMsg");
  if(pct === 1){ tier.textContent = "🏆 مستكشفٌ خبير!"; msg.textContent = "نتيجة كاملة! أنت بطلٌ في المضارع البسيط 🎉"; launchConfetti(); }
  else if(pct >= 0.7){ tier.textContent = "🌟 مستكشفٌ ماهر!"; msg.textContent = "عملٌ رائع! خطوة واحدة وتصبح خبيراً."; launchConfetti(); }
  else if(pct >= 0.5){ tier.textContent = "💪 مستكشفٌ صاعد!"; msg.textContent = "بداية جيدة! راجِع الحرف السحري وحاول مجدداً."; }
  else{ tier.textContent = "🧭 ابدأ المغامرة!"; msg.textContent = "لا بأس! ارجع للدروس وتدرّب، النجاح قريب."; }
}

document.getElementById("qRetry").addEventListener("click", function(){
  qi = 0; score = 0;
  qResult.classList.remove("show");
  quizBody.style.display = "block";
  renderQ();
});

renderQ();

/* ---------- Confetti ---------- */
function launchConfetti(){
  var colors = ["#ffd43b","#2d6cdf","#e63946","#3fa34d","#ffb3c7","#83c5ec"];
  for(var i=0;i<90;i++){
    (function(){
      var c = document.createElement("div");
      c.className = "confetti";
      c.style.left = Math.random()*100 + "vw";
      c.style.background = colors[Math.floor(Math.random()*colors.length)];
      c.style.transform = "rotate("+(Math.random()*360)+"deg)";
      document.body.appendChild(c);
      var dur = 2200 + Math.random()*1800;
      var fall = c.animate(
        [{transform:"translateY(-20px) rotate(0)",opacity:1},
         {transform:"translateY("+(window.innerHeight+40)+"px) rotate("+(360+Math.random()*360)+"deg)",opacity:1}],
        {duration:dur, easing:"ease-in"});
      fall.onfinish = function(){ c.remove(); };
    })();
  }
}
</script>
